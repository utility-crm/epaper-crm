<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Uploads outlive the UI: a 200-page paper takes minutes and must survive the app going away. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Progress notification only. Denial degrades feedback, never the upload itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phone OTP: lets Firebase read its own SMS so the code can auto-fill. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:name=".PublisherApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:largeHeap="true"
        android:theme="@style/Theme.Publisher">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.upload.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
