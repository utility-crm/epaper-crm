{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "epaper-content",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "TEST_SLUG4_DB",
			"database_name": "epaper-test-slug4",
			"database_id": "d9896420-ce09-41b0-b0e9-b31018b4a790"
		}
	],
	"r2_buckets": [
		{
			"binding": "TEST_SLUG4_R2",
			"bucket_name": "epaper-test-slug4"
		}
	]
}