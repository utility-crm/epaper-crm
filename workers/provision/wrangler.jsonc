{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epaper-provision",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "epaper-control",
      "database_id": "xxx-xxx-xxx"
    }
  ],
  "services": [
    {
      "binding": "ADMIN_WORKER",
      "service": "epaper-admin"
    }
  ],
  "vars": {
    "GH_REPO": "your-org/epaper"
  }
  // Note: secret GH_TOKEN should be set via `wrangler secret put`
}
