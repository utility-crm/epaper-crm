{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epaper-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../frontend/shell/dist",
    "not_found_handling": "single-page-application"
  },
  "services": [
    {
      "binding": "ADMIN_WORKER",
      "service": "epaper-admin"
    },
    {
      "binding": "PROVISION_WORKER",
      "service": "epaper-provision"
    },
    {
      "binding": "CONTENT_WORKER",
      "service": "epaper-content"
    },
    {
      "binding": "BILLING_PLATFORM_WORKER",
      "service": "epaper-billing-platform"
    },
    {
      "binding": "BILLING_TENANT_WORKER",
      "service": "epaper-billing-tenant"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://epaperspace.com,https://www.epaperspace.com,https://epaper-crm.pages.dev,https://epaper-portal.pages.dev,https://epaper-gateway.satishkumar-link.workers.dev,http://localhost:5173,http://localhost:5174,http://localhost:5175"
  }
}
