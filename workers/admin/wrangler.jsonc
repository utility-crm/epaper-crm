{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epaper-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "epaper-control",
      "database_id": "b0fff5dc-a1b6-4606-a3fc-10324e1b0df1",
      "migrations_dir": "../../migrations/control"
    }
  ],
  "services": [
    {
      "binding": "PROVISION_WORKER",
      "service": "epaper-provision"
    },
    {
      "binding": "BILLING_PLATFORM_WORKER",
      "service": "epaper-billing-platform"
    },
    {
      "binding": "CONTENT_WORKER",
      "service": "epaper-content"
    },
    {
      "binding": "BILLING_WORKER",
      "service": "epaper-billing-platform"
    },
    {
      // Distinct from BILLING_WORKER/BILLING_PLATFORM_WORKER above (both point at
      // billing-platform). Superadmin manual subscription grants land in the tenant DB,
      // which only billing-tenant has bindings for.
      "binding": "BILLING_TENANT",
      "service": "epaper-billing-tenant"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "epaperspace"
  }
  // Note: secrets ADMIN_JWT_SECRET and ORG_JWT_SECRET should be set via `wrangler secret put`
}
